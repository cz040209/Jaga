# Copy this file to .env and fill in real values. Never commit .env.

# Postgres (Docker)
POSTGRES_USER=jaga
POSTGRES_PASSWORD=change_me
POSTGRES_DB=jaga_db
POSTGRES_PORT=5432

# Redis (Docker)
REDIS_PORT=6380

# Backend connection URLs (password must match POSTGRES_PASSWORD)
DATABASE_URL=postgresql+asyncpg://jaga:change_me@localhost:5432/jaga_db
REDIS_URL=redis://localhost:6380/0

# Auth
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=change_me_to_a_long_random_value
JWT_ACCESS_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# Banking: fake money every new account starts with
OPENING_BALANCE=10000.00
