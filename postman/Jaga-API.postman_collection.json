{
  "info": {
    "name": "Jaga API",
    "description": "**Start the API:** `cd backend && uv run uvicorn app.main:app --reload --port 8010`\n\n**First:** send **Auth → Register**, then **Auth → Login**. Tokens and ids are saved automatically, so every other request just works.\n\nEdge cases (wrong password, 401/403/404/409...) are covered by the automated tests in `backend/tests` (`uv run pytest`).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8010"
    },
    {
      "key": "email",
      "value": ""
    },
    {
      "key": "phone",
      "value": ""
    },
    {
      "key": "password",
      "value": "S3cure-pass!"
    },
    {
      "key": "accessToken",
      "value": ""
    },
    {
      "key": "refreshToken",
      "value": ""
    },
    {
      "key": "sessionId",
      "value": ""
    },
    {
      "key": "deviceId",
      "value": ""
    },
    {
      "key": "payeeAccountNumber",
      "value": ""
    },
    {
      "key": "payeeId",
      "value": ""
    },
    {
      "key": "idempotencyKey",
      "value": ""
    },
    {
      "key": "transferId",
      "value": ""
    }
  ],
