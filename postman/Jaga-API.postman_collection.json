{
  "info": {
    "name": "Jaga API",
    "description": "**Start the API:** `cd backend && uv run uvicorn app.main:app --reload --port 8010`\n\n**First:** send **Auth → Register**, then **Auth → Login**. Tokens and ids are saved automatically, so every other request just works.\n\nEdge cases (wrong password, 401/403/404/409...) are covered by the automated tests in `backend/tests` (`uv run pytest`).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8010"
    },
    {
      "key": "email",
      "value": ""
    },
    {
      "key": "phone",
      "value": ""
    },
    {
      "key": "password",
      "value": "S3cure-pass!"
    },
    {
      "key": "accessToken",
      "value": ""
    },
    {
      "key": "refreshToken",
      "value": ""
    },
    {
      "key": "sessionId",
      "value": ""
    },
    {
      "key": "deviceId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/health",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "health"
          ]
        },
        "description": "API, Postgres and Redis status.",
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('success', () => pm.response.to.be.success);"
            ]
          }
        }
      ]
    },
    {
      "name": "Auth",
      "description": "Register, log in, refresh, log out.",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/auth/register",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            },
            "description": "Creates a customer with a unique email/phone (generated each send) and saves the tokens.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"full_name\": \"Aisyah Rahman\",\n  \"email\": \"{{email}}\",\n  \"phone_number\": \"{{phone}}\",\n  \"password\": \"{{password}}\",\n  \"preferred_language\": \"en\",\n  \"device_fingerprint\": \"fp-postman-phone\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('password', 'S3cure-pass!');",
                  "pm.collectionVariables.set('email', `aisyah+${Date.now()}@jaga.my`);",
                  "const digits = String(Math.floor(Math.random() * 1e7)).padStart(7, '0');",
                  "pm.collectionVariables.set('phone', `012${digits}`);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('success', () => pm.response.to.be.success);",
                  "const res = pm.response.json();",
                  "const tokens = res.tokens || res;",
                  "pm.collectionVariables.set('accessToken', tokens.access_token);",
                  "pm.collectionVariables.set('refreshToken', tokens.refresh_token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "Logs in as the registered customer from a second device (laptop) and saves the tokens.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\",\n  \"device_fingerprint\": \"fp-postman-laptop\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('success', () => pm.response.to.be.success);",
                  "const res = pm.response.json();",
                  "const tokens = res.tokens || res;",
                  "pm.collectionVariables.set('accessToken', tokens.access_token);",
                  "pm.collectionVariables.set('refreshToken', tokens.refresh_token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Refresh",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/auth/refresh",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "refresh"
              ]
            },
            "description": "Swaps the refresh token for a new pair (the old one stops working).",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh_token\": \"{{refreshToken}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('success', () => pm.response.to.be.success);",
                  "const res = pm.response.json();",
                  "const tokens = res.tokens || res;",
                  "pm.collectionVariables.set('accessToken', tokens.access_token);",
                  "pm.collectionVariables.set('refreshToken', tokens.refresh_token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/auth/logout",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "logout"
              ]
            },
            "description": "Ends this session. Send Login again afterwards.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh_token\": \"{{refreshToken}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('success', () => pm.response.to.be.success);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Accounts",
      "description": "Your bank accounts. Balance is worked out from the ledger; money is a string (\"10000.00\").",
      "item": [
        {
          "name": "Get",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/accounts/me",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "accounts",
                "me"
              ]
            },
            "description": "Your open accounts, primary first. A new customer starts with RM 10,000.00 from JAGA-TREASURY."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('success', () => pm.response.to.be.success);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Profile",
      "description": "/customers/me",
      "item": [
        {
          "name": "Get",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/customers/me",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "customers",
                "me"
              ]
            },
            "description": "Your profile."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('success', () => pm.response.to.be.success);"
                ]
              }
            }
          ]
        },
        {
          "name": "Update",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/customers/me",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "customers",
                "me"
              ]
            },
            "description": "Send only the fields to change: full_name, preferred_language (en / ms / zh).",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"full_name\": \"Aisyah Binti Rahman\",\n  \"preferred_language\": \"ms\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('success', () => pm.response.to.be.success);"
                ]
              }
            }
          ]
        },
        {
          "name": "Change password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/customers/me/password",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "customers",
                "me",
                "password"
              ]
            },
            "description": "Other devices are signed out; this one stays logged in.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"current_password\": \"{{password}}\",\n  \"new_password\": \"N3w-secure-pass!\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('success', () => pm.response.to.be.success);",
                  "pm.collectionVariables.set('password', 'N3w-secure-pass!');"
                ]
              }
            }
          ]
        },
        {
          "name": "Close account",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/customers/me",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "customers",
                "me"
              ]
            },
            "description": "Soft delete: the account can't be used again. Requires the password. Refused with 409 balance_not_zero while the account still holds money, which is always the case for a fresh customer until transfers exist.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('closed, or refused because money is left', () => {",
                  "    pm.expect(pm.response.code).to.be.oneOf([204, 409]);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Sessions",
      "description": "Where you're logged in.",
      "item": [
        {
          "name": "List",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/customers/me/sessions",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "customers",
                "me",
                "sessions"
              ]
            },
            "description": "Where you're logged in. Saves another device's session id into {{sessionId}}."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('success', () => pm.response.to.be.success);",
                  "const other = pm.response.json().find(x => !x.is_current);",
                  "if (other) pm.collectionVariables.set('sessionId', other.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Revoke",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{base_url}}/customers/me/sessions/{{sessionId}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "customers",
                "me",
                "sessions",
                "{{sessionId}}"
              ]
            },
            "description": "Signs out one device. Run List first."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('success', () => pm.response.to.be.success);"
                ]
              }
            }
          ]
        },
        {
          "name": "Revoke others",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{base_url}}/customers/me/sessions",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "customers",
                "me",
                "sessions"
              ]
            },
            "description": "Signs out every device except this one."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('success', () => pm.response.to.be.success);"
                ]
              }
            }
          ]
        }
      ]
    },
