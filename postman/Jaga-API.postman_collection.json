{
  "info": {
    "name": "Jaga API",
    "description": "Jaga mock bank + fraud engine API.\n\n**Start the backend first:** `cd backend && uv run uvicorn app.main:app --reload`\n\nRun the whole collection top to bottom with the Collection Runner: it registers a fresh customer each run (unique email/phone), saves the tokens into collection variables automatically, and checks every response.\n\nRequests send `Authorization: Bearer {{accessToken}}` by default (collection-level auth). Login/register/refresh/logout override this with No Auth.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000"
    },
    {
      "key": "password",
      "value": "S3cure-pass!"
    },
    {
      "key": "deviceFingerprint",
      "value": "fp-postman-device-01"
    },
    {
      "key": "email",
      "value": ""
    },
    {
      "key": "phone",
      "value": ""
    },
    {
      "key": "accessToken",
      "value": ""
    },
    {
      "key": "refreshToken",
      "value": ""
    },
    {
      "key": "oldRefreshToken",
      "value": ""
    },
    {
      "key": "customerId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "0. Health",
      "description": "Is the API up, and can it reach Postgres and Redis?",
      "item": [
        {
          "name": "Health check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            },
            "description": "Returns api/db/redis status. Start Docker (Postgres + Redis) first.",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('db and redis ok', () => {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.db).to.eql('ok');",
                  "    pm.expect(body.redis).to.eql('ok');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "1. Auth - happy path",
      "description": "Register, read profile, log in, rotate tokens.",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            },
            "description": "Creates a customer and logs them in. The pre-request script generates a unique email and Malaysian mobile number so you can run this repeatedly.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"full_name\": \"Aisyah Rahman\",\n  \"email\": \"{{email}}\",\n  \"phone_number\": \"{{phone}}\",\n  \"password\": \"{{password}}\",\n  \"preferred_language\": \"en\",\n  \"device_fingerprint\": \"{{deviceFingerprint}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const stamp = Date.now();",
                  "pm.collectionVariables.set('email', `aisyah+${stamp}@jaga.my`);",
                  "// 012 + 7 random digits -> stored by the API as +6012xxxxxxx",
                  "const digits = String(Math.floor(Math.random() * 1e7)).padStart(7, '0');",
                  "pm.collectionVariables.set('phone', `012${digits}`);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 201 Created', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test('returns customer and tokens', () => {",
                  "    pm.expect(body.customer.email).to.eql(pm.collectionVariables.get('email'));",
                  "    pm.expect(body.customer.phone_number).to.match(/^\\+6012\\d{7}$/);",
                  "    pm.expect(body.tokens.token_type).to.eql('bearer');",
                  "    pm.expect(body.is_new_device).to.eql(true);",
                  "});",
                  "pm.test('never returns the password', () => {",
                  "    pm.expect(pm.response.text()).to.not.include('password');",
                  "});",
                  "pm.collectionVariables.set('customerId', body.customer.id);",
                  "// Save tokens so the next requests are authenticated automatically.",
                  "const authBody = pm.response.json();",
                  "if (authBody.tokens) {",
                  "    pm.collectionVariables.set('accessToken', authBody.tokens.access_token);",
                  "    pm.collectionVariables.set('refreshToken', authBody.tokens.refresh_token);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Me",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "me"
              ]
            },
            "description": "Uses the saved access token (collection-level Bearer auth)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('is the registered customer', () => {",
                  "    pm.expect(pm.response.json().id).to.eql(Number(pm.collectionVariables.get('customerId')));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "Same device fingerprint as Register, so is_new_device is false.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\",\n  \"device_fingerprint\": \"{{deviceFingerprint}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('known device', () => pm.expect(pm.response.json().is_new_device).to.eql(false));",
                  "// Save tokens so the next requests are authenticated automatically.",
                  "const authBody = pm.response.json();",
                  "if (authBody.tokens) {",
                  "    pm.collectionVariables.set('accessToken', authBody.tokens.access_token);",
                  "    pm.collectionVariables.set('refreshToken', authBody.tokens.refresh_token);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Login (new device)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "A different fingerprint is flagged as a new device.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\",\n  \"device_fingerprint\": \"fp-unknown-laptop-99\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('new device flagged', () => pm.expect(pm.response.json().is_new_device).to.eql(true));",
                  "// Save tokens so the next requests are authenticated automatically.",
                  "const authBody = pm.response.json();",
                  "if (authBody.tokens) {",
                  "    pm.collectionVariables.set('accessToken', authBody.tokens.access_token);",
                  "    pm.collectionVariables.set('refreshToken', authBody.tokens.refresh_token);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Refresh tokens",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/refresh",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "refresh"
              ]
            },
            "description": "Swaps the refresh token for a new pair. The old refresh token is kept in {{oldRefreshToken}} so a later request can prove it no longer works.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh_token\": \"{{refreshToken}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('oldRefreshToken', pm.collectionVariables.get('refreshToken'));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('refresh token rotated', () => {",
                  "    pm.expect(body.refresh_token).to.not.eql(pm.collectionVariables.get('oldRefreshToken'));",
                  "});",
                  "pm.collectionVariables.set('accessToken', body.access_token);",
                  "pm.collectionVariables.set('refreshToken', body.refresh_token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Me (after refresh)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "me"
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('new access token works', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. Auth - security checks",
      "description": "Requests that MUST be refused.",
      "item": [
        {
          "name": "Register - duplicate email (409)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"full_name\": \"Someone Else\",\n  \"email\": \"{{email}}\",\n  \"phone_number\": \"0199999999\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 409', () => pm.response.to.have.status(409));",
                  "pm.test('code email_taken', () => pm.expect(pm.response.json().code).to.eql('email_taken'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Register - invalid input (422)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"full_name\": \"A\",\n  \"email\": \"not-an-email\",\n  \"phone_number\": \"12345\",\n  \"password\": \"short\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 422', () => pm.response.to.have.status(422));",
                  "pm.test('lists each invalid field', () => {",
                  "    const fields = pm.response.json().detail.map(e => e.loc[e.loc.length - 1]);",
                  "    pm.expect(fields).to.include.members(['full_name', 'email', 'phone_number', 'password']);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Login - wrong password (401)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"wrong-password\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 401', () => pm.response.to.have.status(401));",
                  "pm.collectionVariables.set('wrongPasswordBody', pm.response.text());"
                ]
              }
            }
          ]
        },
        {
          "name": "Login - unknown email (401, same response)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "Must be indistinguishable from a wrong password.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"nobody-here@jaga.my\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 401', () => pm.response.to.have.status(401));",
                  "pm.test('identical to wrong-password response', () => {",
                  "    pm.expect(pm.response.text()).to.eql(pm.collectionVariables.get('wrongPasswordBody'));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Me - no token (401)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "me"
              ]
            },
            "description": "",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 401', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        },
        {
          "name": "Me - garbage token (401)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "me"
              ]
            },
            "description": "",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "not.a.jwt",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 401', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        },
        {
          "name": "Refresh - reuse old token (401)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/refresh",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "refresh"
              ]
            },
            "description": "Refresh tokens are single-use: the one rotated earlier must fail.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh_token\": \"{{oldRefreshToken}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 401', () => pm.response.to.have.status(401));",
                  "pm.test('code invalid_refresh_token', () => {",
                  "    pm.expect(pm.response.json().code).to.eql('invalid_refresh_token');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "3. Logout",
      "description": "End the session; the refresh token must stop working.",
      "item": [
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/logout",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "logout"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh_token\": \"{{refreshToken}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 204', () => pm.response.to.have.status(204));"
                ]
              }
            }
          ]
        },
        {
          "name": "Logout again (still 204)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/logout",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "logout"
              ]
            },
            "description": "Logout is idempotent: calling it twice is safe.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh_token\": \"{{refreshToken}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 204', () => pm.response.to.have.status(204));"
                ]
              }
            }
          ]
        },
        {
          "name": "Refresh after logout (401)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/refresh",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "refresh"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh_token\": \"{{refreshToken}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 401', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
