    {
      "name": "Payees",
      "description": "Saved recipients. The first Lookup creates a second customer (\"Ali\") to use as the recipient; later runs reuse him.",
      "item": [
        {
          "name": "Lookup",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/payees/lookup?account_number={{payeeAccountNumber}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "payees",
                "lookup"
              ],
              "query": [
                {
                  "key": "account_number",
                  "value": "{{payeeAccountNumber}}"
                }
              ]
            },
            "description": "Check an account number before saving: returns the owner's masked name."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// A payee must be someone else's account. The first time, register a second",
                  "// customer (the recipient \"Ali\") and remember his account number.",
                  "// Later clicks reuse the same Ali. To get a new one, clear payeeAccountNumber",
                  "// in the collection's Variables tab.",
                  "if (pm.collectionVariables.get('payeeAccountNumber')) {",
                  "    return;",
                  "}",
                  "const base = pm.variables.get('base_url');",
                  "const digits = String(Math.floor(Math.random() * 1e7)).padStart(7, '0');",
                  "pm.sendRequest({",
                  "    url: `${base}/auth/register`,",
                  "    method: 'POST',",
                  "    header: { 'Content-Type': 'application/json' },",
                  "    body: { mode: 'raw', raw: JSON.stringify({",
                  "        full_name: 'Ali bin Abu Bakar',",
                  "        email: `ali+${Date.now()}@jaga.my`,",
                  "        phone_number: `013${digits}`,",
                  "        password: 'S3cure-pass!'",
                  "    }) }",
                  "}, (err, res) => {",
                  "    const token = res.json().tokens.access_token;",
                  "    pm.sendRequest({",
                  "        url: `${base}/accounts/me`,",
                  "        header: { Authorization: `Bearer ${token}` }",
                  "    }, (err2, res2) => {",
                  "        pm.collectionVariables.set('payeeAccountNumber', res2.json()[0].account_number);",
                  "    });",
                  "});"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('success', () => pm.response.to.be.success);"
                ]
              }
            }
          ]
        },
