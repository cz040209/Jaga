# Copy to .env.local to change the defaults. Never commit .env.local.

# Where the BROWSER calls the FastAPI backend (must be allowed in the backend's CORS_ORIGINS).
NEXT_PUBLIC_API_URL=http://localhost:8010

# Where the Next.js SERVER calls the backend (login/refresh cookie routes). Defaults to the above.
# In Docker this becomes the internal service name, e.g. http://api:8010
API_URL=http://localhost:8010
